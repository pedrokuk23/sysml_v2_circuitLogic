digraph G { rankdir=TB; nodesep=0.16; ranksep=0.2; pad=0.04;
node [fontname="Helvetica", fontsize=16, fontcolor="#0b0b0b", shape=box, style="rounded,filled", fillcolor="#cde2fb", color="#2a78d6", penwidth=1.2, margin="0.08,0.04"];
edge [color="#52514e", arrowsize=0.7, penwidth=1.1, fontname="Helvetica", fontsize=14, fontcolor="#0b0b0b"];
nl [label="natural-\nlanguage\nrequirements", shape=note, fillcolor="#ffffff", color="#52514e"];
sys [label="SysML v2 model\n(requirements, states,\nports, actions,\nvariants, allocations)", shape=note, fillcolor="#ffffff", color="#52514e"];
s [label="parser → IR →\nKerML → SMT (Z3)"];
a [label="logic\nchecks"];
v [label="Verilog\nnetlists"];
l [label="Lustre\nnode"];
y [label="Yosys\nSAT, k-ind.,\nAIG"];
i [label="IC3/PDR\nlemmas"];
k [label="Kind 2\n(cross-\ncheck)"];
o [label="logic views\n+ report", shape=note, fillcolor="#ffffff", color="#0b0b0b"];
nl -> sys [style=dashed]; {rank=same; nl; sys;}
sys -> s; s -> a; s -> v; s -> l; v -> y; y -> i [label=" if open"]; l -> k;
a -> o; y -> o; i -> o; k -> o;
{rank=same; a; v; l;} {rank=same; y; i; k;}
}
