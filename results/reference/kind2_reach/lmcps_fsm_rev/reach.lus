node design(v_apfail: bool; v_limits: bool; v_standby: bool; v_supported: bool) returns (ok_FSM_001: bool; ok_FSM_001v2: bool; ok_FSM_001v3: bool; ok_FSM_002: bool; ok_FSM_003: bool; ok_FSM_004: bool; ok_FSM_005: bool; ok_FSM_006: bool; ok_FSM_007: bool; ok_FSM_008: bool; ok_FSM_009: bool; ok_FSM_010: bool; ok_FSM_011: bool; ok_FSM_012: bool; ok_FSM_013: bool);
var
  v_apState, v_nextState: int;
  v_senState, v_nextSenState: int;
  v_pullup: bool;
  v_mode: bool;
  v_request: bool;
  v_good: bool;
  v_autopilot: bool;
  v_notLimits: bool;
  v_pre1_autopilot: bool;
  v_pre2_autopilot: bool;
  v_pre3_autopilot: bool;
  v_pre1_limits: bool;
  v_pre1_notLimits: bool;
  v_pre2_notLimits: bool;
  v_pre3_notLimits: bool;
  v_pre4_notLimits: bool;
  v_pre5_notLimits: bool;
let
  v_apState = 0 -> pre v_nextState;
  v_nextState = (if v_apState = 0 then (if v_standby then 3 else (if ((v_good and v_supported) and (not v_standby)) then 1 else v_apState)) else (if v_apState = 1 then (if v_standby then 3 else (if ((not v_good) and (not v_standby)) then 2 else v_apState)) else (if v_apState = 2 then (if (v_standby and v_good) then 3 else (if ((v_supported and v_good) and (not v_standby)) then 0 else v_apState)) else (if v_apState = 3 then (if v_apfail then 2 else (if ((not v_standby) and (not v_apfail)) then 0 else v_apState)) else v_apState))));
  v_senState = 0 -> pre v_nextSenState;
  v_nextSenState = (if v_senState = 0 then (if v_limits then 2 else (if ((not v_request) and (not v_limits)) then 1 else v_senState)) else (if v_senState = 1 then (if (v_request and v_mode) then 0 else v_senState) else (if v_senState = 2 then (if ((not v_request) or (not v_limits)) then 1 else v_senState) else v_senState)));
  v_pullup = (2 = v_nextState);
  v_mode = (0 <> v_nextState);
  v_request = ((0 = v_nextState) or (1 = v_nextState));
  v_good = (2 <> v_senState);
  v_autopilot = (((not v_standby) and v_supported) and (not v_apfail));
  v_notLimits = (not v_limits);
  v_pre1_autopilot = false -> pre v_autopilot;
  v_pre2_autopilot = false -> pre v_pre1_autopilot;
  v_pre3_autopilot = false -> pre v_pre2_autopilot;
  v_pre1_limits = false -> pre v_limits;
  v_pre1_notLimits = false -> pre v_notLimits;
  v_pre2_notLimits = false -> pre v_pre1_notLimits;
  v_pre3_notLimits = false -> pre v_pre2_notLimits;
  v_pre4_notLimits = false -> pre v_pre3_notLimits;
  v_pre5_notLimits = false -> pre v_pre4_notLimits;
  ok_FSM_001 = ((((v_limits and (not v_standby)) and (not v_apfail)) and v_supported) => v_pullup);
  ok_FSM_001v2 = (((v_autopilot and v_pre1_autopilot) and v_pre1_limits) => v_pullup);
  ok_FSM_001v3 = (((((((((v_autopilot and v_pre1_autopilot) and v_pre2_autopilot) and v_pre3_autopilot) and v_pre2_notLimits) and v_pre3_notLimits) and v_pre4_notLimits) and v_pre5_notLimits) and v_pre1_limits) => v_pullup);
  ok_FSM_002 = (((0 = v_apState) and v_standby) => (3 = v_nextState));
  ok_FSM_003 = (((((0 = v_apState) and v_good) and v_supported) and (not v_standby)) => (1 = v_nextState));
  ok_FSM_004 = ((((1 = v_apState) and (not v_good)) and (not v_standby)) => (2 = v_nextState));
  ok_FSM_005 = (((1 = v_apState) and v_standby) => (3 = v_nextState));
  ok_FSM_006 = ((((2 = v_apState) and v_standby) and v_good) => (3 = v_nextState));
  ok_FSM_007 = (((((2 = v_apState) and v_supported) and v_good) and (not v_standby)) => (0 = v_nextState));
  ok_FSM_008 = ((((3 = v_apState) and (not v_standby)) and (not v_apfail)) => (0 = v_nextState));
  ok_FSM_009 = (((3 = v_apState) and v_apfail) => (2 = v_nextState));
  ok_FSM_010 = (((0 = v_senState) and v_limits) => (2 = v_nextSenState));
  ok_FSM_011 = ((((0 = v_senState) and (not v_request)) and (not v_limits)) => (1 = v_nextSenState));
  ok_FSM_012 = (((2 = v_senState) and ((not v_request) or (not v_limits))) => (1 = v_nextSenState));
  ok_FSM_013 = ((((1 = v_senState) and v_request) and v_mode) => (0 = v_nextSenState));
  --%PROPERTY "reach_T_Nom" not (v_apState = 0 and v_senState = 0);
  --%PROPERTY "reach_T_Tr" not (v_apState = 0 and v_senState = 1);
  --%PROPERTY "reach_T_F" not (v_apState = 0 and v_senState = 2);
  --%PROPERTY "reach_N_Nom" not (v_apState = 1 and v_senState = 0);
  --%PROPERTY "reach_N_Tr" not (v_apState = 1 and v_senState = 1);
  --%PROPERTY "reach_N_F" not (v_apState = 1 and v_senState = 2);
  --%PROPERTY "reach_M_Nom" not (v_apState = 2 and v_senState = 0);
  --%PROPERTY "reach_M_Tr" not (v_apState = 2 and v_senState = 1);
  --%PROPERTY "reach_M_F" not (v_apState = 2 and v_senState = 2);
  --%PROPERTY "reach_S_Nom" not (v_apState = 3 and v_senState = 0);
  --%PROPERTY "reach_S_Tr" not (v_apState = 3 and v_senState = 1);
  --%PROPERTY "reach_S_F" not (v_apState = 3 and v_senState = 2);
tel
