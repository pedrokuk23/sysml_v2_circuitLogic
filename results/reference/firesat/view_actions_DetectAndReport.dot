digraph G {
rankdir=LR; nodesep=0.35; ranksep=0.55;
node [fontname="Helvetica", fontsize=11];
fontname="Helvetica";
label=<<b>Logic view — action flow DetectAndReport</b><br/><font point-size="10">decide = MUX · join = &amp; · merge = ≥1</font>>; labelloc=t; fontsize=14;
"start" [shape=circle, style=filled, fillcolor=black, label="", width=0.25];
"observe" [shape=box, style=rounded];
"detect" [shape=box, style=rounded];
"fireCheck" [shape=invtrapezium, label="MUX\nfireCheck", color="black", fontcolor="black"];
"geolocate" [shape=box, style=rounded];
"done" [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.2];
"split" [shape=box, style=filled, fillcolor=black, fontcolor=white, width=0.15, height=1.0, fixedsize=true, label=""];
"retryMerge" [shape=diamond, label="≥1", fontsize=10, width=0.5, height=0.5, fixedsize=true];
"archive" [shape=box, style=rounded];
"downlink" [shape=box, style=rounded];
"linkCheck" [shape=invtrapezium, label="MUX\nlinkCheck", color="#c62828", fontcolor="#c62828"];
"sync" [shape=box, style=filled, fillcolor=black, fontcolor=white, width=0.15, height=1.0, fixedsize=true, label="&"];
"retry" [shape=box, style=rounded];
"notify" [shape=box, style=rounded];
"start" -> "observe";
"observe" -> "detect";
"detect" -> "fireCheck";
"fireCheck" -> "geolocate" [label="[fire]", fontsize=10];
"fireCheck" -> "done" [label="[not fire]", fontsize=10];
"geolocate" -> "split";
"split" -> "retryMerge";
"split" -> "archive";
"retryMerge" -> "downlink";
"downlink" -> "linkCheck";
"linkCheck" -> "sync" [label="[linkUp]", fontsize=10];
"linkCheck" -> "retry" [label="[linkUp and backlog]", fontsize=10];
"retry" -> "retryMerge";
"archive" -> "sync";
"sync" -> "notify";
"notify" -> "done";
"note_linkCheck" [shape=note, style=filled, fillcolor="#fdecea", color="#c62828", fontcolor="#c62828", fontsize=10, label="linkCheck\nincomplete selection: And(Not(linkUp), Not(And(linkUp, backlog)))\noverlapping guards: sync & retry"];
"linkCheck" -> "note_linkCheck" [color="#c62828", style=dashed, arrowhead=none];
"summary" [shape=note, style=filled, fillcolor="#fff4e0", color="#e08a00", label="deadlock in 2 of 8 input valuations\npossible loop in 1\nnominal cycle (min): 6; each loop: +4"];
}