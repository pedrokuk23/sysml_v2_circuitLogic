digraph G {
rankdir=LR; splines=spline; nodesep=0.25; ranksep=0.9;
node [fontname="Helvetica", fontsize=11];
fontname="Helvetica";
label=<<b>Logic view — apMachine: requirements as next-state logic</b><br/><font point-size="10">&amp; = AND gate · ○ = negation · <font color="#c62828">contention = conflict</font> · <font color="#e08a00">floating line = hole</font></font>>; labelloc=t; fontsize=14;
subgraph cluster_in { label="inputs"; style=dashed; color="#999999"; fontsize=10;
"apState=T" [shape=plaintext, label="apState = T"];
"apState=N" [shape=plaintext, label="apState = N"];
"apState=M" [shape=plaintext, label="apState = M"];
"apState=S" [shape=plaintext, label="apState = S"];
"apfail" [shape=plaintext];
"good" [shape=plaintext];
"standby" [shape=plaintext];
"supported" [shape=plaintext];
}
subgraph cluster_bus { label="next-state bus"; style=dashed; color="#999999"; fontsize=10;
"bus_T" [shape=cds, style=filled, fillcolor="#e8eef7", color="#1f5aa6", label="next = T"];
"bus_N" [shape=cds, style=filled, fillcolor="#e8eef7", color="#1f5aa6", label="next = N"];
"bus_M" [shape=cds, style=filled, fillcolor="#e8eef7", color="#1f5aa6", label="next = M"];
"bus_S" [shape=cds, style=filled, fillcolor="#e8eef7", color="#1f5aa6", label="next = S"];
}
"g_FSM-002" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-002</font>>];
"apState=T" -> "g_FSM-002" [arrowhead=none, color="#444444"];
"standby" -> "g_FSM-002" [arrowhead=none, color="#444444"];
"g_FSM-002" -> "bus_S" [color="#1f5aa6", penwidth=1.6];
"g_FSM-003" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-003</font>>];
"apState=T" -> "g_FSM-003" [arrowhead=none, color="#444444"];
"good" -> "g_FSM-003" [arrowhead=none, color="#444444"];
"supported" -> "g_FSM-003" [arrowhead=none, color="#444444"];
"g_FSM-003" -> "bus_N" [color="#1f5aa6", penwidth=1.6];
"g_FSM-004" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-004</font>>];
"apState=N" -> "g_FSM-004" [arrowhead=none, color="#444444"];
"good" -> "g_FSM-004" [arrowhead=odot, color="#444444"];
"g_FSM-004" -> "bus_M" [color="#1f5aa6", penwidth=1.6];
"g_FSM-005" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-005</font>>];
"apState=N" -> "g_FSM-005" [arrowhead=none, color="#444444"];
"standby" -> "g_FSM-005" [arrowhead=none, color="#444444"];
"g_FSM-005" -> "bus_S" [color="#1f5aa6", penwidth=1.6];
"g_FSM-006" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-006</font>>];
"apState=M" -> "g_FSM-006" [arrowhead=none, color="#444444"];
"standby" -> "g_FSM-006" [arrowhead=none, color="#444444"];
"good" -> "g_FSM-006" [arrowhead=none, color="#444444"];
"g_FSM-006" -> "bus_S" [color="#1f5aa6", penwidth=1.6];
"g_FSM-007" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-007</font>>];
"apState=M" -> "g_FSM-007" [arrowhead=none, color="#444444"];
"supported" -> "g_FSM-007" [arrowhead=none, color="#444444"];
"good" -> "g_FSM-007" [arrowhead=none, color="#444444"];
"g_FSM-007" -> "bus_T" [color="#1f5aa6", penwidth=1.6];
"g_FSM-008" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-008</font>>];
"apState=S" -> "g_FSM-008" [arrowhead=none, color="#444444"];
"standby" -> "g_FSM-008" [arrowhead=odot, color="#444444"];
"g_FSM-008" -> "bus_T" [color="#1f5aa6", penwidth=1.6];
"g_FSM-009" [shape=box, width=0.55, height=0.75, fixedsize=true, label="&", fontsize=15, fontname="Helvetica-Bold", style="rounded,filled", fillcolor=white, xlabel=<<font point-size="10" color="#555555">FSM-009</font>>];
"apState=S" -> "g_FSM-009" [arrowhead=none, color="#444444"];
"apfail" -> "g_FSM-009" [arrowhead=none, color="#444444"];
"g_FSM-009" -> "bus_M" [color="#1f5aa6", penwidth=1.6];
"c_FSM-002_FSM-003" [shape=note, style=filled, fillcolor="#fdecea", color="#c62828", fontcolor="#c62828", fontsize=10, label="CONTENTION FSM-002 × FSM-003\napState=T: good ∧ standby ∧ supported"];
"g_FSM-002" -> "c_FSM-002_FSM-003" [color="#c62828", style=dashed, arrowhead=none];
"g_FSM-003" -> "c_FSM-002_FSM-003" [color="#c62828", style=dashed, arrowhead=none];
"c_FSM-004_FSM-005" [shape=note, style=filled, fillcolor="#fdecea", color="#c62828", fontcolor="#c62828", fontsize=10, label="CONTENTION FSM-004 × FSM-005\napState=N: standby ∧ ¬good"];
"g_FSM-004" -> "c_FSM-004_FSM-005" [color="#c62828", style=dashed, arrowhead=none];
"g_FSM-005" -> "c_FSM-004_FSM-005" [color="#c62828", style=dashed, arrowhead=none];
"c_FSM-006_FSM-007" [shape=note, style=filled, fillcolor="#fdecea", color="#c62828", fontcolor="#c62828", fontsize=10, label="CONTENTION FSM-006 × FSM-007\napState=M: good ∧ standby ∧ supported"];
"g_FSM-006" -> "c_FSM-006_FSM-007" [color="#c62828", style=dashed, arrowhead=none];
"g_FSM-007" -> "c_FSM-006_FSM-007" [color="#c62828", style=dashed, arrowhead=none];
"c_FSM-008_FSM-009" [shape=note, style=filled, fillcolor="#fdecea", color="#c62828", fontcolor="#c62828", fontsize=10, label="CONTENTION FSM-008 × FSM-009\napState=S: apfail ∧ ¬standby"];
"g_FSM-008" -> "c_FSM-008_FSM-009" [color="#c62828", style=dashed, arrowhead=none];
"g_FSM-009" -> "c_FSM-008_FSM-009" [color="#c62828", style=dashed, arrowhead=none];
"f_T" [shape=note, style=filled, fillcolor="#fff4e0", color="#e08a00", fontcolor="#8a5200", fontsize=10, label="in T: 6/16 unspecified\n(¬good ∧ ¬standby) ∨ (¬standby ∧ ¬supported)\n→ SysML: stay"];
"bus_T" -> "f_T" [color="#e08a00", style=dotted, arrowhead=none];
"f_N" [shape=note, style=filled, fillcolor="#fff4e0", color="#e08a00", fontcolor="#8a5200", fontsize=10, label="in N: 4/16 unspecified\ngood ∧ ¬standby\n→ SysML: stay"];
"bus_N" -> "f_N" [color="#e08a00", style=dotted, arrowhead=none];
"f_M" [shape=note, style=filled, fillcolor="#fff4e0", color="#e08a00", fontcolor="#8a5200", fontsize=10, label="in M: 10/16 unspecified\n¬good ∨ (¬standby ∧ ¬supported)\n→ SysML: stay"];
"bus_M" -> "f_M" [color="#e08a00", style=dotted, arrowhead=none];
"f_S" [shape=note, style=filled, fillcolor="#fff4e0", color="#e08a00", fontcolor="#8a5200", fontsize=10, label="in S: 4/16 unspecified\nstandby ∧ ¬apfail\n→ SysML: stay"];
"bus_S" -> "f_S" [color="#e08a00", style=dotted, arrowhead=none];
}